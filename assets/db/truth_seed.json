 "clauses": [
  {
   "editions": [
    "PHYSICS-0"
   ],
   "locator": "P-AC3",
   "title": "Three-phase current from real power",
   "topic": "physics",
   "intent": "Line current of a balanced three-phase load or source from kW, line-to-line volts and power factor. Use datasheet continuous current for code calcs when available.",
   "formulas": [
    {
     "key": "I3",
     "name": "Three-phase line current",
     "form": "equation",
     "expression": "P_kW*1000/(sqrt(3)*V_LL*PF)",
     "output_symbol": "I",
     "output_unit": "A",
     "terms": [
      {
       "symbol": "P_kW",
       "meaning": "real power",
       "unit": "kW",
       "role": "input"
      },
      {
       "symbol": "V_LL",
       "meaning": "line-to-line voltage",
       "unit": "V",
       "role": "input"
      },
      {
       "symbol": "PF",
       "meaning": "power factor (1.0 for kVA basis)",
       "unit": "1",
       "role": "input"
      }
     ]
    }
   ]
  },
  {
   "editions": [
    "PHYSICS-0"
   ],
   "locator": "P-AC1",
   "title": "Single-phase current from real power",
   "topic": "physics",
   "intent": "Current of a single-phase load or source from kW, circuit voltage and power factor.",
   "formulas": [
    {
     "key": "I1",
     "name": "Single-phase current",
     "form": "equation",
     "expression": "P_kW*1000/(V*PF)",
     "output_symbol": "I",
     "output_unit": "A",
     "terms": [
      {
       "symbol": "P_kW",
       "meaning": "real power",
       "unit": "kW",
       "role": "input"
      },
      {
       "symbol": "V",
       "meaning": "circuit voltage",
       "unit": "V",
       "role": "input"
      },
      {
       "symbol": "PF",
       "meaning": "power factor",
       "unit": "1",
       "role": "input"
      }
     ]
    }
   ]
  },
  {
   "editions": [
    "PHYSICS-0"
   ],
   "locator": "P-DC",
   "title": "DC current from power",
   "topic": "physics",
   "intent": "Battery or PV DC current from power and DC bus voltage (use the minimum operating voltage for worst-case current).",
   "formulas": [
    {
     "key": "IDC",
     "name": "DC current",
     "form": "equation",
     "expression": "P_kW*1000/V_dc",
     "output_symbol": "I_dc",
     "output_unit": "A",
     "terms": [
      {
       "symbol": "P_kW",
       "meaning": "DC power",
       "unit": "kW",
       "role": "input"
      },
      {
       "symbol": "V_dc",
       "meaning": "DC voltage (min of operating window for worst case)",
       "unit": "V",
       "role": "input"
      }
     ]
    }
   ]
  },
  {
   "editions": [
    "PHYSICS-0"
   ],
   "locator": "P-ENERGY",
   "title": "Usable energy, delivered energy and runtime",
   "topic": "physics",
   "intent": "Usable energy is gross energy times depth of discharge only when the rating given is gross; a datasheet usable rating must not be derated again. Delivered AC energy applies one-way discharge efficiency, not round-trip efficiency.",
   "formulas": [
    {
     "key": "EUSE",
     "name": "Usable energy from gross rating",
     "form": "equation",
     "expression": "E_gross*DoD",
     "output_symbol": "E_usable",
     "output_unit": "kWh",
     "note": "Skip when the manufacturer already states usable energy.",
     "terms": [
      {
       "symbol": "E_gross",
       "meaning": "nameplate gross energy",
       "unit": "kWh",
       "role": "rating-fact",
       "param": "energy_gross"
      },
      {
       "symbol": "DoD",
       "meaning": "depth of discharge fraction",
       "unit": "1",
       "role": "input"
      }
     ]
    },
    {
     "key": "EAC",
     "name": "Delivered AC energy",
     "form": "equation",
     "expression": "E_usable*eta_dis",
     "output_symbol": "E_ac",
     "output_unit": "kWh",
     "note": "eta_dis is one-way discharge efficiency; sqrt(RTE) is only an approximation when no one-way figure exists.",
     "terms": [
      {
       "symbol": "E_usable",
       "meaning": "usable DC energy",
       "unit": "kWh",
       "role": "input"
      },
      {
       "symbol": "eta_dis",
       "meaning": "one-way discharge efficiency",
       "unit": "1",
       "role": "input"
      }
     ]
    },
    {
     "key": "RUN",
     "name": "Runtime at constant power",
     "form": "equation",
     "expression": "E_kWh/P_kW",
     "output_symbol": "t",
     "output_unit": "h",
     "terms": [
      {
       "symbol": "E_kWh",
       "meaning": "energy available",
       "unit": "kWh",
       "role": "input"
      },
      {
       "symbol": "P_kW",
       "meaning": "constant discharge power",
       "unit": "kW",
       "role": "input"
      }
     ]
    }
   ]
  },
  {
   "editions": [
    "PHYSICS-0"
   ],
   "locator": "P-VD",
   "title": "Voltage drop",
   "topic": "physics",
   "intent": "Approximate voltage drop percentage using conductor resistance per 1000 ft (from NEC Chapter 9 Table 8/9). Limits are design targets, not mandatory code values.",
   "formulas": [
    {
     "key": "VD3",
     "name": "Three-phase voltage drop percent",
     "form": "equation",
     "expression": "sqrt(3)*I*L_ft*R_kft/1000/V_LL*100",
     "output_symbol": "VD_pct",
     "output_unit": "%",
     "terms": [
      {
       "symbol": "I",
       "meaning": "load current",
       "unit": "A",
       "role": "input"
      },
      {
       "symbol": "L_ft",
       "meaning": "one-way length",
       "unit": "ft",
       "role": "input"
      },
      {
       "symbol": "R_kft",
       "meaning": "resistance per 1000 ft",
       "unit": "ohm/kft",
       "role": "input"
      },
      {
       "symbol": "V_LL",
       "meaning": "line-to-line voltage",
       "unit": "V",
       "role": "input"
      }
     ]
    },
    {
     "key": "VD2",
     "name": "Two-wire (1-ph or DC) voltage drop percent",
     "form": "equation",
     "expression": "2*I*L_ft*R_kft/1000/V*100",
     "output_symbol": "VD_pct",
     "output_unit": "%",
     "terms": [
      {
       "symbol": "I",
       "meaning": "current",
       "unit": "A",
       "role": "input"
      },
      {
       "symbol": "L_ft",
       "meaning": "one-way length",
       "unit": "ft",
       "role": "input"
      },
      {
       "symbol": "R_kft",
       "meaning": "resistance per 1000 ft",
       "unit": "ohm/kft",
       "role": "input"
      },
      {
       "symbol": "V",
       "meaning": "circuit voltage",
       "unit": "V",
       "role": "input"
      }
     ]
    }
   ]
  },
  {
   "editions": [
    "NEC-2020",
    "NEC-2023"
   ],
   "locator": "690.7(A)",
   "title": "PV maximum voltage, temperature corrected",
   "topic": "pv-voltage",
   "applies_to": [
    "pv_string",
    "pv_inverter",
    "hybrid_inverter"
   ],
   "intent": "Maximum PV DC voltage is the series sum of module open-circuit voltage corrected to the lowest expected ambient temperature using the manufacturer temperature coefficient.",
   "formulas": [
    {
     "key": "VOC",
     "name": "Temperature-corrected string Voc",
     "form": "equation",
     "expression": "N_s*Voc_stc*(1+beta_voc*(T_min_c-25))",
     "output_symbol": "V_max",
     "output_unit": "V",
     "note": "beta_voc as a fraction per degC (negative).",
     "terms": [
      {
       "symbol": "N_s",
       "meaning": "modules in series",
       "unit": "1",
       "role": "input"
      },
      {
       "symbol": "Voc_stc",
       "meaning": "module Voc at STC",
       "unit": "V",
       "role": "rating-fact",
       "param": "voc_stc"
      },
      {
       "symbol": "beta_voc",
       "meaning": "Voc temperature coefficient",
       "unit": "1/degC",
       "role": "rating-fact",
       "param": "voc_temp_coeff"
      },
      {
       "symbol": "T_min_c",
       "meaning": "lowest expected ambient",
       "unit": "degC",
       "role": "input"
      }
     ]
    }
   ]
  },
  {
   "editions": [
    "NEC-2020",
    "NEC-2023"
   ],
   "locator": "690.8(A)(1)",
   "title": "PV source circuit maximum current",
   "topic": "pv-current",
   "applies_to": [
    "pv_string",
    "dc_combiner"
   ],
   "intent": "PV source circuit maximum current is 125 percent of the summed parallel module short-circuit current (one of the permitted methods).",
   "constants": [
    {
     "key": "K690",
     "symbol": "K_isc",
     "value": 1.25,
     "unit": "1",
     "meaning": "irradiance multiplier on Isc"
    }
   ],
   "formulas": [
    {
     "key": "IMAX",
     "name": "PV source circuit max current",
     "form": "equation",
     "expression": "K_isc*Isc*N_p",
     "output_symbol": "I_max",
     "output_unit": "A",
     "terms": [
      {
       "symbol": "K_isc",
       "meaning": "multiplier",
       "unit": "1",
       "role": "constant",
       "constant": "K690"
      },
      {
       "symbol": "Isc",
       "meaning": "module short-circuit current",
       "unit": "A",
       "role": "rating-fact",
       "param": "isc_stc"
      },
      {
       "symbol": "N_p",
       "meaning": "parallel strings",
       "unit": "1",
       "role": "input"
      }
     ]
    }
   ]
  },
  {
   "editions": [
    "NEC-2020",
    "NEC-2023"
   ],
   "locator": "690.12",
   "title": "PV rapid shutdown",
   "topic": "pv-rsd",
   "applies_to": [
    "rapid_shutdown",
    "pv_array"
   ],
   "intent": "PV circuits on or in buildings need a rapid shutdown function controlling conductors inside and outside the array boundary, with an initiation device and labeling."
  },
  {
   "editions": [
    "NEC-2020",
    "NEC-2023"
   ],
   "locator": "705.11",
   "title": "Supply-side source connections",
   "topic": "interconnection",
   "applies_to": [
    "service_switchboard"
   ],
   "intent": "Connection on the supply side of the service disconnect has its own conductor, disconnect and overcurrent rules; it is a different method from load-side 705.12 and needs separate evidence."
  },
  {
   "editions": [
    "NEC-2020",
    "NEC-2023"
   ],
   "locator": "705.12(B)(3)(1)",
   "title": "Busbar: 100 percent method",
   "topic": "interconnection",
   "applies_to": [
    "service_switchboard",
    "distribution_board",
    "critical_load_panel"
   ],
   "intent": "125 percent of the summed power-source output current plus the busbar main OCPD rating must not exceed busbar ampacity.",
   "constants": [
    {
     "key": "K125",
     "symbol": "K_src",
     "value": 1.25,
     "unit": "1",
     "meaning": "multiplier on power-source output current"
    }
   ],
   "formulas": [
    {
     "key": "B100",
     "name": "Busbar 100 percent check",
     "form": "check",
     "expression": "K_src*I_src_sum + I_main <= I_bus",
     "output_symbol": "ok",
     "output_unit": "bool",
     "terms": [
      {
       "symbol": "K_src",
       "meaning": "multiplier",
       "unit": "1",
       "role": "constant",
       "constant": "K125"
      },
      {
       "symbol": "I_src_sum",
       "meaning": "sum of inverter/PCS continuous output currents (or PCS setting per 705.13)",
       "unit": "A",
       "role": "input"
      },
      {
       "symbol": "I_main",
       "meaning": "OCPD protecting the busbar",
       "unit": "A",
       "role": "input"
      },
      {
       "symbol": "I_bus",
       "meaning": "busbar ampacity",
       "unit": "A",
       "role": "rating-fact",
       "param": "bus_rating"
      }
     ]
    }
   ]
  },
  {
   "editions": [
    "NEC-2020",
    "NEC-2023"
   ],
   "locator": "705.12(B)(3)(2)",
   "title": "Busbar: 120 percent method",
   "topic": "interconnection",
   "applies_to": [
    "service_switchboard",
    "distribution_board",
    "critical_load_panel"
   ],
   "intent": "With source breakers at the opposite end of the busbar from the main supply and a permanent warning label, 125 percent of source current plus the main OCPD may reach 120 percent of busbar ampacity.",
   "constants": [
    {
     "key": "K125",
     "symbol": "K_src",
     "value": 1.25,
     "unit": "1",
     "meaning": "multiplier on power-source output current"
    },
    {
     "key": "K120",
     "symbol": "K_bus",
     "value": 1.2,
     "unit": "1",
     "meaning": "busbar allowance"
    }
   ],
   "formulas": [
    {
     "key": "B120",
     "name": "Busbar 120 percent check",
     "form": "check",
     "expression": "K_src*I_src_sum + I_main <= K_bus*I_bus",
     "output_symbol": "ok",
     "output_unit": "bool",
     "note": "Also requires opposite-end placement and label; the inequality alone is not compliance.",
     "terms": [
      {
       "symbol": "K_src",
       "meaning": "multiplier",
       "unit": "1",
       "role": "constant",
       "constant": "K125"
      },
      {
       "symbol": "K_bus",
       "meaning": "busbar allowance",
       "unit": "1",
       "role": "constant",
       "constant": "K120"
      },
      {
       "symbol": "I_src_sum",
       "meaning": "sum of source continuous output currents",
       "unit": "A",
       "role": "input"
      },
      {
       "symbol": "I_main",
