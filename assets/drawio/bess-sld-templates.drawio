;entryDy=0;" edge="1" parent="B-L1" source="B-v80" target="B-v82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object><object id="B-v86" label="" class_id="estop" symbol_id="estop" tag="ESD" scope="new"><mxCell style="pointerEvents=1;verticalLabelPosition=bottom;shadow=0;dashed=0;align=center;html=1;verticalAlign=top;shape=mxgraph.electrical.electro-mechanical.pushbuttonBreak2;elSwitchState=on;" vertex="1" parent="B-L1"><mxGeometry x="1115" y="427.0" width="50.0" height="26.0" as="geometry"/></mxCell></object><mxCell id="B-v87" value="&lt;b&gt;ESD&lt;/b&gt;&lt;br&gt;Emergency shutdown" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=0;fontSize=9;" vertex="1" parent="B-L4"><mxGeometry x="1105" y="391.0" width="90" height="34" as="geometry"/></mxCell><object id="B-e88" label="" domain="control"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=6;strokeWidth=1;dashed=1;dashPattern=8 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="B-L3" source="B-v86" target="B-v63"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="837" y="440"/></Array></mxGeometry></mxCell></object><object id="B-e89" label="" domain="control"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=6;strokeWidth=1;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="B-L3" source="B-v33" target="B-v63"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="270"/><mxPoint x="1185" y="472"/><mxPoint x="802" y="472"/></Array></mxGeometry></mxCell></object><object id="B-v90" label="" class_id="grounding_electrode" symbol_id="ground" tag="GND-BESS" scope="new"><mxCell style="pointerEvents=1;verticalLabelPosition=bottom;shadow=0;dashed=0;align=center;html=1;verticalAlign=top;shape=mxgraph.electrical.signal_sources.protective_earth;" vertex="1" parent="B-L1"><mxGeometry x="1000" y="792.0" width="20.0" height="16.0" as="geometry"/></mxCell></object><mxCell id="B-v91" value="&lt;b&gt;GND-BESS&lt;/b&gt;&lt;br&gt;EGC/GEC; neutral bond per manual" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=0;fontSize=9;" vertex="1" parent="B-L4"><mxGeometry x="1026.0" y="792.0" width="120" height="46" as="geometry"/></mxCell><object id="B-e92" label="" domain="pe"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=1;dashed=1;dashPattern=1 4 4 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="B-L2" source="B-v82" target="B-v90"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object><mxCell id="B-v93" value="&lt;b&gt;MODES:&lt;/b&gt; grid-parallel, islanded (MID open, HINV grid-forming), bypass (MBP on grid). Only {{CLP_TAG}} is backed up. To back up PV, move it to the CLP side or DC-couple it to HINV." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=0;fontSize=9;" vertex="1" parent="B-L4"><mxGeometry x="30" y="720" width="420" height="70" as="geometry"/></mxCell><mxCell id="B-v94" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;" vertex="1" parent="B-L0"><mxGeometry x="10" y="10" width="1200" height="990" as="geometry"/></mxCell><mxCell id="B-v95" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;" vertex="1" parent="B-L0"><mxGeometry x="930" y="890" width="280" height="110" as="geometry"/></mxCell><mxCell id="B-v96" value="&lt;b&gt;{{PROJECT_NAME}}&lt;/b&gt;&lt;br&gt;{{SITE_ADDRESS}}&lt;br&gt;SLD-B: Backup option, hybrid PCS with critical load panel&lt;br&gt;Sheet {{SHEET}} &amp;nbsp; Rev {{REV}} &amp;nbsp; {{DATE}}&lt;br&gt;&lt;b&gt;PRELIMINARY: NOT FOR CONSTRUCTION&lt;/b&gt;&lt;br&gt;Seal area intentionally blank" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=0;fontSize=8;" vertex="1" parent="B-L4"><mxGeometry x="938" y="896" width="265" height="100" as="geometry"/></mxCell><mxCell id="B-v97" value="&lt;b&gt;SLD-B: Backup option, hybrid PCS with critical load panel&lt;/b&gt; &amp;nbsp; (NTS) &amp;nbsp; Operating modes: grid-parallel / islanded / bypass" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=0;fontSize=12;" vertex="1" parent="B-L4"><mxGeometry x="30" y="20" width="900" height="20" as="geometry"/></mxCell><mxCell id="B-v98" value="&lt;b&gt;KEYED NOTES&lt;/b&gt; (templates; resolve placeholders and cite the clause of the selected edition)&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; [N-SERVICE] Field verify {voltage_basis_configuration_phases_wires_grounding} and {service_bus_main_ratings} before equipment selection.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; [N-OCP] Coordinate {protective_device_and_settings} with {calculated_available_fault_current}, {equipment_sccr_aic} and {conductor_protection_basis}.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; [N-CONDUCTOR] Provide {conductor_material_size_insulation_quantity_neutral_egc}, {termination_temperature_basis} and {ampacity_calculation_reference}.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; [N-ESS-LISTING] Identify the listing/certification scope for {exact_ess_combination}; install to {manual_revision}.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; [N-ISOLATION] Show {source_isolation_and_transfer_devices}, {control_power_and_failure_response} and {permitted_parallel_operation_basis}.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; [N-BACKUP-BOUNDARY] Loads on {critical_load_panel} are served in islanded mode through {isolation_device}; loads on {non_backed_panels} are not backed up.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; [N-PCS-SETTING] Power control system {listed_pcs_function} limits {controlled_quantity} to {setting_value}; settings access restricted per {manual_revision}.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; [N-UTILITY] Comply with {actual_utility_tariff_and_approved_interconnection}, including {required_settings_and_witness_tests}.&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; [N-GROUND] Identify {grounding_electrode_egc_gec_and_bonding_details}, including {neutral_switching_and_derived_system_basis}." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=0;fontSize=8;" vertex="1" parent="B-L4"><mxGeometry x="30" y="845" width="890" height="150" as="geometry"/></mxCell><mxCell id="B-v99" value="LINES: power solid &amp;nbsp; sense dashed 4-4 &amp;nbsp; control dashed 8-4 (arrow = command) &amp;nbsp; grounding dash-dot" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=0;fontSize=8;" vertex="1" parent="B-L4"><mxGeometry x="30" y="815" width="700" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="G" name="Legend: symbol map"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="G-L0" value="Frame" parent="0"/><mxCell id="G-L1" value="Power" parent="0"/><mxCell id="G-L2" value="Grounding" parent="0"/><mxCell id="G-L3" value="Sense-Control" parent="0"/><mxCell id="G-L4" value="Annotation" parent="0"/><mxCell id="G-v1" value="&lt;b&gt;Symbol map&lt;/b&gt;: class, Draw.io realization (stencil = verified palette shape; composite/basic = drawn), QET element" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;spacing=0;fontSize=12;" vertex="1" parent="G-L4"><mxGeometry x="30" y="24" width="1100" height="20" as="geometry"/></mxCell><object id="G-v2" label="COMMS" class_id="comms_enclosure" symbol_id="aux_box" tag="COMMS" scope="legend"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="G-L1"><mxGeometry x="30" y="60" width="60.0" height="26.0" as="geometry"/></mxCell></object><mxCell id="G-v3" value="&lt;b&gt;Communications enclosure&lt;/b&gt; (COMMS)&lt;br&gt;basic: &lt;br&gt;QET: to author" style="text